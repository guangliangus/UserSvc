<Project Sdk="Microsoft.NET.Sdk">

  <!-- Decision 03 · Dependency rule: references Domain and nothing else.
       Any of EntityFrameworkCore / Npgsql / AspNetCore appearing here is an architecture
       violation and tests/UserSvc.ArchitectureTests will fail the build. -->
  <ItemGroup>
    <ProjectReference Include="../UserSvc.Domain/UserSvc.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seven i18n bundles are the Go service's own locale files, so error text stays identical
         across the cutover. They are data, not code: the messages are Chinese, Japanese, Korean,
         Thai and Vietnamese, which a .cs file in this repository may not contain. Adding a language
         is one more JSON file plus one entry in SupportedLocales. -->
    <EmbeddedResource Include="Features/Localization/Locales/*.json" />
  </ItemGroup>

</Project>
