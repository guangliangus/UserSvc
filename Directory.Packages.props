<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="AspNetCore">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
  </ItemGroup>

  <!-- OpenIddict is the OAuth2/OIDC protocol stack (decision 10). Do NOT reference the
       'OpenIddict' metapackage: its net10.0 group drags in the OAuth *client* stack
       (Client, Client.WebIntegration, Client.SystemIntegration, Client.SystemNetHttp,
       Validation.SystemNetHttp), none of which this service has any use for. -->
  <ItemGroup Label="Identity">
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.6.1" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.6.1" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.6.1" />
    <PackageVersion Include="OpenIddict.Validation.ServerIntegration" Version="7.6.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <!-- 决策 15：EF Core 单栈。原生 SQL 走 EF 自己的 SqlQuery/FromSql/ExecuteSql。
       刻意不引入 Dapper —— 它不会自动加入 EF 事务，且会绕过全局查询过滤器
       （软删除、租户隔离）。新增数据访问依赖前先读 docs/architecture.md。 -->
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- 显式钉住：Npgsql 10.0.3 传递引用的是 10.0.4，不钉会有版本冲突警告 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <!-- Argon2id password hashing. Pure managed C#, MIT, ships a net8.0 target group that net10.0
       resolves against; it pulls Konscious.Security.Cryptography.Blake2 transitively.
       The alternative, Isopoh.Cryptography.Argon2, carries a SecureArray/native-locking layer
       this service has no use for. -->
  <ItemGroup Label="Cryptography">
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- Reads the bcrypt hashes the Go service left behind, so the 17 existing back-office
         accounts can sign in on cutover day and be rehashed with Argon2id as they do. MIT, pure
         managed C#, and its 4.2.1 net10.0 target group has zero package dependencies.
         READ-ONLY: nothing in this service calls HashPassword. PasswordHasher.Hash writes
         Argon2id only, so migration is a one-way ratchet - see that class. -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
  </ItemGroup>

  <ItemGroup Label="Identity providers and storage">
    <!-- WebAuthn / FIDO2 ceremony engine. No external service: it verifies attestations and
         assertions locally against our own credential rows. -->
    <PackageVersion Include="Fido2" Version="4.0.1" />
    <!-- Verifies Firebase ID tokens against Google's rotating public keys. -->
    <PackageVersion Include="FirebaseAdmin" Version="3.6.0" />
    <!-- Object storage behind IObjectStorage. The port is what the service depends on; this is one
         adapter for it. -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
  </ItemGroup>

  <ItemGroup Label="Caching">
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <ItemGroup Label="Resilience">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Extensions">
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <!-- The logging ABSTRACTION is allowed in the inner rings; the architecture guard bans Serilog,
         which is the implementation. An application service that cannot say what went wrong is
         worse coupled than one that depends on ILogger<T>. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- BackgroundService / IHostedService / AddHostedService. EF Core does NOT bring this
         transitively, so a hosted service in Infrastructure fails with CS0234 without it. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
  </ItemGroup>

</Project>
